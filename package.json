{
  "name": "pokemon-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "description": "Personal-use Pokemon TCG stock monitor for EU stores.",
  "scripts": {
    "postinstall": "npm run db:generate --workspace @pokemon-monitor/db",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate --workspace @pokemon-monitor/db",
    "db:migrate": "npm run db:migrate --workspace @pokemon-monitor/db",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @pokemon-monitor/db"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
