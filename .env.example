# Local Docker Postgres shown below. A Prisma Postgres database also works
# via its direct-connection string, e.g.
# postgresql://<user>:<password>@db.prisma.io:5432/postgres
# -- obtained by running `npx prisma postgres link --database <ID>` from
# packages/db locally with your own Prisma account; never commit that URL.
DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_monitor
REDIS_URL=redis://localhost:6379
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PLAYWRIGHT_ENABLED=true
LOG_LEVEL=info
POLL_INTERVAL_OVERRIDE=
